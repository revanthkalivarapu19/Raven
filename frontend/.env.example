# RAVEN Frontend Environment Configuration

# Enable sample demonstration data (optional: true / false)
VITE_ENABLE_SAMPLES=false

# Use the local FastAPI backend (set false to keep demo-only behavior)
VITE_RAVEN_USE_REAL_BACKEND=true

# Vite proxies /api requests to this backend during development
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Optional backend API base URL (defaults to relative /api when proxied)
# VITE_API_BASE_URL=http://localhost:8000
