# Provider configuration (set real values in .env; never commit secrets)
ENABLE_GDELT=false
GOOGLE_FACTCHECK_API_KEY=
NEWS_API_KEY=
# Optional URL for an explicitly configured SearXNG discovery service. Empty disables it.
SEARXNG_BASE_URL=

# Existing Raven settings
DATA_DIR=data
HF_HUB_OFFLINE=false
TRANSFORMERS_OFFLINE=false
REQUEST_DEADLINE_SECONDS=300
# Maximum per-provider network timeout in seconds. Requests honors the process
# HTTP_PROXY, HTTPS_PROXY, and NO_PROXY settings when configured by the host.
TIMEOUT_SECONDS=30
# Set true when the embedding model must load only from the local Hugging Face cache.
EMBEDDING_LOCAL_FILES_ONLY=false
