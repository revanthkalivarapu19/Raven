# Provider configuration (set real values in .env; never commit secrets)
ENABLE_GDELT=false
GOOGLE_FACTCHECK_API_KEY=
NEWS_API_KEY=

# Existing Raven settings
DATA_DIR=data
HF_HUB_OFFLINE=false
TRANSFORMERS_OFFLINE=false
REQUEST_DEADLINE_SECONDS=300
# Set true when the embedding model must load only from the local Hugging Face cache.
EMBEDDING_LOCAL_FILES_ONLY=false
